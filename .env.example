# Local inference is the default. Use an OpenAI-compatible local server.
AI_MODE=local
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_NAME=

# Cloud mode is opt-in: set AI_MODE=openrouter and provide your key.
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini
OPENROUTER_HEAVY_MODEL=openai/gpt-4o-mini
OPENROUTER_MAX_TOKENS=1024
